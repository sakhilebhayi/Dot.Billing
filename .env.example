APP_NAME="Dot.Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://billing.infodot.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Dot Knowledge Protocol (DKP) — see storage/app/private/README.md
DKP_SIGNING_KEY_PATH=
DKP_KEY_ID=dot-billing-dkp-signing-v1

# InfoDot sign-in (redeem). INFODOT_SERVICE_SECRET must be the same value as
# ECOSYSTEM_SECRET_BILLING in InfoDot's .env, and InfoDot must have Billing marked live.
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=billing
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# Billing engine (no payment provider is configured or needed)
BILLING_INVOICE_NUMBER_FORMAT="INV-{YYYY}-{seq}"
BILLING_INVOICE_NUMBER_PAD=4
BILLING_PAYMENT_TERMS_DAYS=14
BILLING_AUTO_FINALIZE_INVOICES=true
BILLING_TAX_RATE=0
BILLING_ISSUER_NAME=
BILLING_ISSUER_ADDRESS=
BILLING_ISSUER_TAX_NUMBER=
BILLING_ISSUER_EMAIL=
BILLING_FREE_SEAT_LIMIT=3
BILLING_FREE_STORAGE_GB=1

# Entitlements API: one secret per calling platform (blank = that platform cannot call).
# Generate with: php -r 'echo bin2hex(random_bytes(32));'
BILLING_ENTITLEMENT_SECRET_FILES=
BILLING_ENTITLEMENT_SECRET_MINES=

# Overdue reminders via Dot.Notify (blank = disabled). The secret is this app's NOTIFY_INGEST_SECRET_BILLING in Notify's .env.
NOTIFY_INGEST_URL=
NOTIFY_INGEST_SECRET=

# Paystack online payment (TEST MODE ONLY). Blank = online payment is switched off.
# Test keys only (sk_test_... / pk_test_...). A sk_live_ key is refused unless PAYSTACK_ALLOW_LIVE=true is ALSO set.
# Register https://<your-host>/webhooks/paystack as the webhook URL in the Paystack dashboard.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_ALLOW_LIVE=false
PAYSTACK_ATTEMPT_TTL_MINUTES=30
# Daily aggregate metrics snapshot to Dot.Analytics (blank = nothing is sent). URL is the full ingest URL, e.g.
# https://analytics.infodot.co.za/api/ingest/snapshots. The secret must equal ANALYTICS_INGEST_SECRET_BILLING in Analytics' .env.
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_SECRET=
ANALYTICS_PLATFORM_KEY=billing

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false
